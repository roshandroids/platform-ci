{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roshandroids/platform-ci/schema/ci.schema.json",
  "title": "platform-ci configuration",
  "type": "object",
  "required": ["schema", "flutter", "kind", "paths"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1,
      "description": "Config schema version"
    },
    "flutter": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["app", "package", "melos", "cli"]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional Node for sidecars (e.g. AI Tray bridge)",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "version": { "type": "string", "default": "22" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "boolean", "default": true },
        "analyze": { "type": "boolean", "default": true },
        "test": { "type": "boolean", "default": true },
        "coverage": { "type": "boolean", "default": false },
        "coverage_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Informational unless enforce_coverage true"
        },
        "enforce_coverage": { "type": "boolean", "default": false },
        "golden": { "type": "boolean", "default": false },
        "exclude_golden_from_test": {
          "type": "boolean",
          "default": true,
          "description": "When golden true, main test uses --exclude-tags=golden"
        },
        "integration": { "type": "boolean", "default": false },
        "melos_filter": { "type": "string", "default": "" },
        "scripts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra repo-root shell commands after standard quality (changelog, boundaries, etc.)"
        }
      }
    },
    "pr_builds": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" },
      "default": []
    },
    "main_builds": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" },
      "default": []
    },
    "release_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" },
      "default": []
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "#/$defs/buildTarget" },
        "android": { "$ref": "#/$defs/buildTarget" },
        "ios": { "$ref": "#/$defs/buildTarget" },
        "macos": { "$ref": "#/$defs/buildTarget" },
        "windows": { "$ref": "#/$defs/buildTarget" },
        "linux": { "$ref": "#/$defs/buildTarget" },
        "cli": { "$ref": "#/$defs/buildTarget" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": { "type": "boolean", "default": true },
        "before_build": {
          "type": "string",
          "default": "",
          "description": "Shell command at repo root before each build target (sidecar assemble, etc.)"
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firebase": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "project_id": { "type": "string" },
            "on": {
              "type": "array",
              "items": { "type": "string", "enum": ["main", "tag"] },
              "default": ["main"]
            },
            "preview_on_pr": { "type": "boolean", "default": false }
          }
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "on": {
              "type": "array",
              "items": { "type": "string", "enum": ["main", "tag"] },
              "default": ["main"]
            },
            "source": { "type": "string", "default": "web" }
          }
        },
        "demos": {
          "type": "object",
          "additionalProperties": false,
          "description": "Multi-demo Flutter web site (Document_Platform pattern)",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "manifest": { "type": "string", "default": "showcase/demos.json" },
            "base_href_prefix": { "type": "string", "default": "/" }
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "path": { "type": "string", "default": "." },
            "dry_run_on_pr": { "type": "boolean", "default": true }
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "string",
      "enum": ["web", "android", "ios", "linux", "macos", "windows", "cli"]
    },
    "buildTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "script": {
          "type": "string",
          "default": "",
          "description": "If set, run this instead of default flutter build; must populate dist/<target>/"
        },
        "package": {
          "type": "string",
          "enum": ["none", "zip"],
          "default": "none",
          "description": "zip = compress default build output into dist/<target>/"
        }
      }
    }
  }
}
